{
  "name": "live2dpet",
  "version": "2.0.0",
  "description": "Standalone desktop pet companion with AI chat",
  "author": "x380kkm",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "dev": "node launch.js --dev",
    "test": "node --test tests/test-core.js tests/test-enhance.js tests/test-config-manager.js tests/test-crypto-utils.js tests/test-validators.js",
    "build": "electron-builder --win nsis",
    "build:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "active-win": "^8.2.1",
    "electron-log": "^5.4.3",
    "koffi": "^2.15.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "node-gyp": "^13.0.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "tar": "^7.5.16"
  },
  "build": {
    "appId": "com.live2dpet.app",
    "productName": "Live2DPet Workspace",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "launch.js",
      "mcp-server.js",
      "index.html",
      "desktop-pet.html",
      "pet-chat-bubble.html",
      "calendar.html",
      "flashcard-review.html",
      "agent-history.html",
      "observation-viewer.html",
      "src/**/*",
      "assets/**/*",
      "libs/**/*"
    ],
    "asarUnpack": [
      "node_modules/**",
      "mcp-server.js"
    ],
    "extraResources": [
      {
        "from": "voicevox_core",
        "to": "voicevox_core",
        "filter": ["**/*"]
      }
    ],
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "README.en.md",
        "to": "README.en.md"
      },
      {
        "from": "README.ja.md",
        "to": "README.ja.md"
      },
      { "from": "THIRD_PARTY_LICENSES.md", 
        "to": "THIRD_PARTY_LICENSES.md" 
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Live2DPet-Setup-${version}.exe"
    }
  }
}